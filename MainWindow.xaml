<Window x:Class="EasySave.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasySave.ViewModel"
        xmlns:v="clr-namespace:EasySave.View"
        Title="EasySave" Height="500" Width="900">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:JobListViewModel}">
            <v:JobListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobEditorViewModel}">
            <v:JobEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupExecutionViewModel}">
            <v:BackupExecutionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2a3350"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3a4460"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#1a1f2e">
            <TextBlock Text="EasySave" Foreground="White"
                       FontSize="20" FontWeight="Bold" Margin="16,24,0,24"/>

            <Button Content="{Binding Loc[nav_jobs]}"
                    Command="{Binding ShowJobsCommand}"
                    Style="{StaticResource NavButtonStyle}"/>

            <Button Content="{Binding Loc[nav_execution]}"
                    Command="{Binding ShowExecutionCommand}"
                    Style="{StaticResource NavButtonStyle}"/>

            <Button Content="{Binding Loc[nav_settings]}"
                    Command="{Binding ShowSettingsCommand}"
                    Style="{StaticResource NavButtonStyle}"/>
        </StackPanel>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>