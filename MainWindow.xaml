<Window x:Class="EasySave.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasySave.ViewModel"
        xmlns:v="clr-namespace:EasySave.View"
        Title="EasySave" Height="500" Width="900">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:JobListViewModel}">
            <v:JobListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobEditorViewModel}">
            <v:JobEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupExecutionViewModel}">
            <v:BackupExecutionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#1a1f2e">
            <TextBlock Text="EasySave" Foreground="White"
                       FontSize="20" FontWeight="Bold" Margin="16,24,0,24"/>

            <!-- ✅ Textes bindés sur Loc -->
            <Button Content="{Binding Loc[nav_jobs]}"
                    Command="{Binding ShowJobsCommand}"
                    Foreground="White" Background="Transparent"
                    BorderThickness="0" Padding="16,10"
                    HorizontalContentAlignment="Left"/>

            <Button Content="{Binding Loc[nav_execution]}"
                    Command="{Binding ShowExecutionCommand}"
                    Foreground="White" Background="Transparent"
                    BorderThickness="0" Padding="16,10"
                    HorizontalContentAlignment="Left"/>

            <Button Content="{Binding Loc[nav_settings]}"
                    Command="{Binding ShowSettingsCommand}"
                    Foreground="White" Background="Transparent"
                    BorderThickness="0" Padding="16,10"
                    HorizontalContentAlignment="Left"/>
        </StackPanel>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>