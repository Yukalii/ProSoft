<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<AssemblyName>EasySave</AssemblyName>
		<RootNamespace>EasySave</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Localisation\Languages\en.json">
			<Link>Languages\en.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Localisation\Languages\fr.json">
			<Link>Languages\fr.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Prevent CryptoSoft source files from being compiled into ProSoft -->
	<ItemGroup>
		<Compile Remove="CryptoSoft\**\*.cs" />
		<Compile Remove="EasyLog\**\*.cs" />
		<Compile Remove="EasyLogServer\**\*" />
	</ItemGroup>

	<!-- Ensures CryptoSoft is built before ProSoft -->
	<ItemGroup>
		<ProjectReference Include="CryptoSoft\CryptoSoft.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<!-- don't link its DLLs -->
			<SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="CryptoSoft\" />
	</ItemGroup>

	
	<ItemGroup>
		<ProjectReference Include="EasyLog\EasyLog.csproj" />
	</ItemGroup>

	<!-- After ProSoft builds, copy CryptoSoft.exe next to it -->
	<Target Name="CopyCryptoSoft" AfterTargets="Build">
		<Warning Condition="!Exists('CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.exe')" Text="CryptoSoft.exe not found — skipping copy. Build CryptoSoft first." />
		<ItemGroup>
			<CryptoSoftFiles Include="CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.*" Condition="Exists('CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.exe')" />
		</ItemGroup>
		<Copy SourceFiles="@(CryptoSoftFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	</Target>

</Project>