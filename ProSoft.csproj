<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- Prevent CryptoSoft source files from being compiled into ProSoft -->
	<ItemGroup>
		<Compile Remove="CryptoSoft\**\*.cs" />
	</ItemGroup>

	<!-- Ensures CryptoSoft is built before ProSoft -->
	<ItemGroup>
		<ProjectReference Include="CryptoSoft\CryptoSoft.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<!-- don't link its DLLs -->
			<SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
		</ProjectReference>
	</ItemGroup>

	<!-- After ProSoft builds, copy CryptoSoft.exe next to it -->
	<Target Name="CopyCryptoSoft" AfterTargets="Build">
		<Warning
		  Condition="!Exists('CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.exe')"
		  Text="CryptoSoft.exe not found — skipping copy. Build CryptoSoft first." />
		<Copy
		  Condition="Exists('CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.exe')"
		  SourceFiles="CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.exe"
		  DestinationFolder="$(OutputPath)"
		  SkipUnchangedFiles="true"
		/>
	</Target>

</Project>