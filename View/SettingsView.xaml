<UserControl x:Class="EasySave.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" MaxWidth="500" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="{Binding DataContext.Loc[settings_title], RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="{Binding DataContext.Loc[settings_language], RelativeSource={RelativeSource AncestorType=Window}}"
                   VerticalAlignment="Center" Margin="0,0,0,12"/>
        <ComboBox  Grid.Row="1" Grid.Column="1"
                   ItemsSource="{Binding Languages}"
                   SelectedItem="{Binding SelectedLanguage}"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="{Binding DataContext.Loc[settings_logformat], RelativeSource={RelativeSource AncestorType=Window}}"
                   VerticalAlignment="Center" Margin="0,0,0,20"/>
        <ComboBox  Grid.Row="2" Grid.Column="1"
                   ItemsSource="{Binding LogFormats}"
                   SelectedItem="{Binding SelectedLogFormat}"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
           Text="{Binding DataContext.Loc[settings_largefilelimit], RelativeSource={RelativeSource AncestorType=Window}}"
           VerticalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBox Width="80"
             Text="{Binding LargeFileThresholdKb, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="KB" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="{Binding DataContext.Loc[settings_businessapp], RelativeSource={RelativeSource AncestorType=Window}}"
                   VerticalAlignment="Center" Margin="0,0,0,20"/>
        <TextBox Grid.Row="4" Grid.Column="1"
                   Text="{Binding BusinessApp, UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="5" Grid.Column="0"
                   Text="{Binding DataContext.Loc[settings_cryptokey],
                          RelativeSource={RelativeSource AncestorType=Window}}"
                   VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox   Grid.Row="5" Grid.Column="1"
                   Text="{Binding CryptoSoftKey, UpdateSourceTrigger=PropertyChanged}"
                   Padding="4,3" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="6" Grid.Column="0"
                   Text="{Binding DataContext.Loc[settings_extensions],
                          RelativeSource={RelativeSource AncestorType=Window}}"
                   VerticalAlignment="Top" Margin="0,4,0,0"/>

        <ListBox Grid.Row="6" Grid.Column="1"
                 ItemsSource="{Binding EncryptedExtensions}"
                 MaxHeight="130" Margin="0,0,0,8"
                 BorderThickness="1" BorderBrush="#CCCCCC"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>

                        <Button Grid.Column="1"
                                Content="X"
                                Command="{Binding DataContext.RemoveExtensionCommand,
                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#CC0000"
                                Cursor="Hand"
                                Padding="6,2"
                                FontSize="11"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" MinWidth="150" Margin="0,0,8,0">
                <TextBox Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,3"
                         x:Name="ExtInput"/>
                <TextBlock Text=".docx"
                           Foreground="Gray"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Padding="0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewExtension}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NewExtension}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1"
                    Content="{Binding DataContext.Loc[settings_add_extension],
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding AddExtensionCommand}"
                    Padding="10,4"/>
        </Grid>

        <Button Grid.Row="8" Grid.ColumnSpan="2"
                Content="{Binding DataContext.Loc[settings_save], RelativeSource={RelativeSource AncestorType=Window}}"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Left" Padding="12,6"/>
    </Grid>
</UserControl>