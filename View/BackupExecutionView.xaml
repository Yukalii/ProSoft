<UserControl x:Class="EasySave.View.BackupExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="600" HorizontalAlignment="Left">

            <TextBlock Text="{Binding DataContext.Loc[exec_title], RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,24"/>

            <TextBlock Text="{Binding DataContext.Loc[exec_section_launch], RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,8"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataContext.Loc[exec_job_label], RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="200"
                              ItemsSource="{Binding AvailableJobs, Mode=OneWay}"
                              SelectedItem="{Binding SelectedJob}"
                              DisplayMemberPath="Name"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="{Binding DataContext.Loc[exec_start], RelativeSource={RelativeSource AncestorType=Window}}"
                            Command="{Binding StartJobCommand}" Padding="12,6"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DataContext.Loc[exec_section_status], RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,8"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding DataContext.Loc[exec_job_name], RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="#888" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding RunningJobName, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding DataContext.Loc[exec_state], RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="#888"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding State, Mode=OneWay}" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding DataContext.Loc[exec_section_progress], RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,8"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding DataContext.Loc[exec_total_files], RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="#888" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding TotalFiles, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding DataContext.Loc[exec_processed_files], RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="#888" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ProcessedFiles, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{Binding DataContext.Loc[exec_processed_size], RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="#888"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding ProcessedSize, Mode=OneWay}" FontWeight="SemiBold"/>
                    </Grid>

                    <ProgressBar Height="14" 
                                 Minimum="0"
                                 Maximum="{Binding TotalFilesDisplay, Mode=OneWay}"
                                 Value="{Binding ProcessedFiles, Mode=OneWay}"
                                 Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding CurrentSourceFile, Mode=OneWay}"
                               Foreground="#888" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>