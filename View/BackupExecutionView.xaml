<UserControl x:Class="EasySave.View.BackupExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" MaxWidth="600" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Exécution" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="{Binding JobName,        Mode=OneWay, StringFormat='Job : {0}'}"/>
            <TextBlock Text="{Binding State,          Mode=OneWay, StringFormat='État : {0}'}"/>
            <TextBlock Text="{Binding TotalFiles,     Mode=OneWay, StringFormat='Total fichiers : {0}'}"/>
            <TextBlock Text="{Binding ProcessedFiles, Mode=OneWay, StringFormat='Traités : {0}'}"/>
            <TextBlock Text="{Binding ProcessedSize,  Mode=OneWay, StringFormat='Taille traitée : {0} octets'}"/>
        </StackPanel>

        <ProgressBar Grid.Row="2" Height="20" Margin="0,0,0,8"
                     Minimum="0"
                     Maximum="{Binding TotalFiles,     Mode=OneWay}"
                     Value="{Binding ProcessedFiles,   Mode=OneWay}"/>

        <TextBlock Grid.Row="3"
                   Text="{Binding CurrentSourceFile, Mode=OneWay, StringFormat='Fichier actuel : {0}'}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Job à lancer :" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="200"
                     Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="▶ Démarrer" Command="{Binding StartJobCommand}" Padding="12,6"/>
        </StackPanel>
    </Grid>
</UserControl>