<UserControl x:Class="EasySave.View.JobListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding DataContext.Loc[jobs_title], RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Jobs}"
                  SelectedItem="{Binding SelectedJob}"
                  BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          Click="CheckBox_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{Binding DataContext.Loc[jobs_col_name], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="160" DisplayMemberBinding="{Binding Job.Name}"/>
                    <GridViewColumn Header="{Binding DataContext.Loc[jobs_col_source], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="Auto" DisplayMemberBinding="{Binding Job.SourcePath}"/>
                    <GridViewColumn Header="{Binding DataContext.Loc[jobs_col_target], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="Auto" DisplayMemberBinding="{Binding Job.TargetPath}"/>
                    <GridViewColumn Header="{Binding DataContext.Loc[jobs_col_strategy], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="140" DisplayMemberBinding="{Binding Job.StrategyName}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{Binding DataContext.Loc[jobs_add], RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding DataContext.ShowJobEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="{Binding DataContext.Loc[jobs_delete], RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding DeleteJobCommand}"
                    Padding="12,6" Margin="0,0,8,0"/>

            <Button Content="{Binding DataContext.Loc[jobs_run], RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding DataContext.RunSelectedJobsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="12,6" Margin="0,0,8,0"/>

            <Button Content="{Binding DataContext.Loc[jobs_edit], RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding EditJobCommand}"
                    Padding="12,6"/>
        </StackPanel>
    </Grid>
</UserControl>